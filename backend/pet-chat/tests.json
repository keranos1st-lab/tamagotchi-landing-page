{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Status",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {
        "configured": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Empty message",
      "method": "POST",
      "path": "/",
      "body": {
        "message": ""
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "empty"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Voice status",
      "method": "GET",
      "path": "/?voice=1",
      "expectedStatus": 200,
      "expectedBody": {
        "voice": {}
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "STT status",
      "method": "GET",
      "path": "/?stt=1",
      "expectedStatus": 200,
      "expectedBody": {
        "stt": {}
      },
      "bodyMatcher": "partial"
    }
  ]
}