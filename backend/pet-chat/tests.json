{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Status",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {
        "configured": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Empty message",
      "method": "POST",
      "path": "/",
      "body": {
        "message": ""
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "empty"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Voice status",
      "method": "GET",
      "path": "/?voice=1",
      "expectedStatus": 200,
      "expectedBody": {
        "voice": {}
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "STT status",
      "method": "GET",
      "path": "/?stt=1",
      "expectedStatus": 200,
      "expectedBody": {
        "stt": {
          "rate": 16000,
          "maxSeconds": 30
        }
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "STT empty audio",
      "method": "POST",
      "path": "/?stt=1",
      "body": {
        "audio": "",
        "rate": 16000
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "stt_too_short"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "STT wrong rate",
      "method": "POST",
      "path": "/?stt=1",
      "body": {
        "audio": "AAAA",
        "rate": 44100
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "stt_bad_audio"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "STT not base64",
      "method": "POST",
      "path": "/?stt=1",
      "body": {
        "audio": "!!!",
        "rate": 16000
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "stt_bad_audio"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Baby IQ refuses long text",
      "method": "POST",
      "path": "/",
      "body": {
        "message": "",
        "task": {
          "action": "explain",
          "source": "слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово слово "
        },
        "pet": {
          "name": "Лисичка",
          "type": "fox",
          "iq": 10
        }
      },
      "expectedStatus": 200,
      "expectedBody": {
        "declined": true,
        "iqLevel": "baby"
      },
      "bodyMatcher": "partial"
    }
  ]
}